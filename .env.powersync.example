# Credenciais da CLI do PowerSync SÓ deste projeto. Copie para .env.powersync.local (ignorado pelo git)
# e use `pnpm ps <comando>` (ex.: `pnpm ps validate`, `pnpm ps deploy sync-config`).
#
# Token: painel do PowerSync → conta (canto superior direito) → Access Tokens (crie um chamado "glife").
PS_ADMIN_TOKEN=
# Ids da instância Production (estão em INFRA.local.md e na URL do painel: /org/<ORG_ID>/project/<PROJECT_ID>/<INSTANCE_ID>).
ORG_ID=
PROJECT_ID=
INSTANCE_ID=
