# Credenciais da CLI do Supabase SÓ deste projeto. Copie para .env.supabase.local (ignorado pelo git)
# e use `pnpm sb <comando>` em vez de `npx supabase <comando>`.
#
# Token: https://supabase.com/dashboard/account/tokens  (crie um chamado "glife")
SUPABASE_ACCESS_TOKEN=
# Opcional: senha do banco. Sem ela, `pnpm sb db push --remote` usa um acesso temporário criado pelo token.
SUPABASE_DB_PASSWORD=
